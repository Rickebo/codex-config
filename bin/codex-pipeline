#!/usr/bin/env bash
set -euo pipefail

seed_prompt=$'Operating mode: pipeline-fsm manager.\nRoot session is manager-only and must not write code directly.\nUse deterministic stage flow with persisted state: spec -> code -> review -> test -> validation.\nWhen a stage fails, route only via configured transitions in /home/rickebo/.codex/pipeline/transitions.json.\nBefore stage work begins, initialize or read run state via: node /home/rickebo/.codex/bin/pipeline-controller.mjs init --profile full.\nSpec stage requirements:\n- produce a feature spec JSON aligned with /home/rickebo/.codex/pipeline/feature-spec.schema.json\n- run node /home/rickebo/.codex/bin/pipeline-spec-check.mjs --spec <SPEC_JSON> --out <SPEC_CHECK_JSON>\n- include spec_file, spec_check_file, and council_file in the spec stage report\nFor each stage, write a stage report JSON file that conforms to /home/rickebo/.codex/pipeline/stage-report.schema.json.\nAfter each stage report, advance state via pipeline-controller.mjs advance and obey returned next_stage.\nIf advance returns approval_required=true, stop stage progression and run pipeline-controller.mjs approve before continuing.\nDelegate by stage owner:\n- spec -> planner + reviewer + tech_lead_qa (+ researcher when needed) to form a testable/verifiable spec\n- code -> tech_lead_backend and/or tech_lead_frontend and/or tech_lead_devops\n- review -> reviewer (plus targeted lead follow-up if needed)\n- test -> tech_lead_qa (plus targeted lead follow-up if needed)\n- validation -> tech_lead_qa or planner for requirement-trace checks\nLead reasoning default is medium; raise to high only for high-risk or ambiguous lanes.\nKeep stage reports concise using caps: summary<=600 chars, changed_files<=20, validation<=12, blockers<=8, next_action<=300 chars, issues<=15.\nIf loop_count exceeds max_loops, stop and escalate to user.'
forced_config=(-c agents.max_depth=2 -c agents.max_threads=4)

render_prompt() {
  local user_prompt="${1-}"
  if [[ -n "$user_prompt" ]]; then
    printf '%s\n\n%s' "$seed_prompt" "$user_prompt"
  else
    printf '%s' "$seed_prompt"
  fi
}

parse_top_level() {
  local -a forward=()
  local prompt=""
  local sandbox_set=false

  while (($#)); do
    case "$1" in
      -h|--help|-V|--version)
        exec codex "$@"
        ;;
      -c|--config|--enable|--disable|-i|--image|-m|--model|--local-provider|-p|--profile|-s|--sandbox|-a|--ask-for-approval|-C|--cd|--add-dir)
        if [[ "$1" == "-s" || "$1" == "--sandbox" ]]; then
          sandbox_set=true
        fi
        forward+=("$1")
        shift
        if (($# == 0)); then
          printf 'codex-pipeline: missing value for option\n' >&2
          exit 2
        fi
        forward+=("$1")
        shift
        ;;
      --sandbox=*)
        sandbox_set=true
        forward+=("$1")
        shift
        ;;
      --*=*)
        forward+=("$1")
        shift
        ;;
      --oss|--full-auto|--dangerously-bypass-approvals-and-sandbox|--search|--no-alt-screen)
        forward+=("$1")
        shift
        ;;
      exec)
        parse_exec "${@:2}"
        return
        ;;
      review|login|logout|mcp|mcp-server|app-server|completion|sandbox|debug|apply|resume|fork|cloud|features|help)
        exec codex "$@"
        ;;
      --)
        shift
        prompt="$*"
        break
        ;;
      -*)
        forward+=("$1")
        shift
        ;;
      *)
        prompt="$*"
        break
        ;;
    esac
  done

  if ! $sandbox_set; then
    forward+=("-s" "read-only")
  fi

  exec /home/rickebo/.codex/bin/codex-stable "${forced_config[@]}" "${forward[@]}" "$(render_prompt "$prompt")"
}

parse_exec() {
  local -a forward=(exec)
  local prompt=""
  local sandbox_set=false

  while (($#)); do
    case "$1" in
      -h|--help|-V|--version)
        exec codex exec "$@"
        ;;
      review|resume|help)
        exec codex exec "$@"
        ;;
      -c|--config|--enable|--disable|-i|--image|-m|--model|--local-provider|-p|--profile|-s|--sandbox|-C|--cd|--add-dir|-o|--output-last-message|--output-schema|--color)
        if [[ "$1" == "-s" || "$1" == "--sandbox" ]]; then
          sandbox_set=true
        fi
        forward+=("$1")
        shift
        if (($# == 0)); then
          printf 'codex-pipeline exec: missing value for option\n' >&2
          exit 2
        fi
        forward+=("$1")
        shift
        ;;
      --sandbox=*)
        sandbox_set=true
        forward+=("$1")
        shift
        ;;
      --*=*)
        forward+=("$1")
        shift
        ;;
      --oss|--full-auto|--dangerously-bypass-approvals-and-sandbox|--skip-git-repo-check|--ephemeral|--progress-cursor|--json)
        forward+=("$1")
        shift
        ;;
      --)
        shift
        prompt="$*"
        break
        ;;
      -*)
        forward+=("$1")
        shift
        ;;
      *)
        prompt="$*"
        break
        ;;
    esac
  done

  if ! $sandbox_set; then
    forward+=("-s" "read-only")
  fi

  exec /home/rickebo/.codex/bin/codex-stable "${forced_config[@]}" "${forward[@]}" "$(render_prompt "$prompt")"
}

parse_top_level "$@"
