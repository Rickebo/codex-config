{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rickebo.local/codex/pipeline/feature-spec.schema.json",
  "title": "Codex Pipeline Feature Spec",
  "type": "object",
  "required": [
    "meta",
    "feature",
    "requirements",
    "acceptance_criteria",
    "test_plan",
    "traceability"
  ],
  "properties": {
    "meta": {
      "type": "object",
      "required": ["id", "title", "author", "created_at", "version"],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^SPEC-[A-Za-z0-9._-]+$"
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "author": {
          "type": "string",
          "minLength": 1
        },
        "created_at": {
          "type": "string",
          "format": "date-time"
        },
        "version": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false
    },
    "feature": {
      "type": "object",
      "required": ["problem_statement", "goals", "non_goals", "scope_in", "scope_out"],
      "properties": {
        "problem_statement": {
          "type": "string",
          "minLength": 1
        },
        "goals": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 1
        },
        "non_goals": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "scope_in": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 1
        },
        "scope_out": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "additionalProperties": false
    },
    "requirements": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "priority", "statement", "rationale"],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^REQ-[0-9]{3,}$"
          },
          "priority": {
            "type": "string",
            "enum": ["MUST", "SHOULD", "MAY"]
          },
          "statement": {
            "type": "string",
            "minLength": 1
          },
          "rationale": {
            "type": "string",
            "minLength": 1
          }
        },
        "additionalProperties": false
      }
    },
    "acceptance_criteria": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "requirement_ids", "scenario"],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^AC-[0-9]{3,}$"
          },
          "requirement_ids": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "pattern": "^REQ-[0-9]{3,}$"
            }
          },
          "scenario": {
            "type": "string",
            "minLength": 1
          }
        },
        "additionalProperties": false
      }
    },
    "test_plan": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "type", "requirement_ids", "approach"],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^TST-[0-9]{3,}$"
          },
          "type": {
            "type": "string",
            "enum": ["unit", "integration", "e2e", "non_functional", "manual"]
          },
          "requirement_ids": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "pattern": "^REQ-[0-9]{3,}$"
            }
          },
          "approach": {
            "type": "string",
            "minLength": 1
          }
        },
        "additionalProperties": false
      }
    },
    "traceability": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["requirement_id", "acceptance_ids", "test_ids", "review_checks", "validation_checks"],
        "properties": {
          "requirement_id": {
            "type": "string",
            "pattern": "^REQ-[0-9]{3,}$"
          },
          "acceptance_ids": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "pattern": "^AC-[0-9]{3,}$"
            }
          },
          "test_ids": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "pattern": "^TST-[0-9]{3,}$"
            }
          },
          "review_checks": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "validation_checks": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "additionalProperties": false
      }
    },
    "quality_gates": {
      "type": "object",
      "properties": {
        "spec_review_required": {
          "type": "boolean"
        },
        "testability_required": {
          "type": "boolean"
        },
        "traceability_required": {
          "type": "boolean"
        }
      },
      "additionalProperties": false
    },
    "council": {
      "type": "object",
      "properties": {
        "perspectives": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["role", "summary"],
            "properties": {
              "role": {
                "type": "string",
                "minLength": 1
              },
              "summary": {
                "type": "string",
                "minLength": 1
              }
            },
            "additionalProperties": false
          }
        },
        "consensus_summary": {
          "type": "string"
        },
        "open_questions": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
