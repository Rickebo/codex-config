{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.codicarium.com/release/publisher-dispatch-receipt-v1.schema.json",
  "title": "Codicarium publisher dispatch receipt v1",
  "type": "object",
  "required": [
    "body",
    "signature"
  ],
  "properties": {
    "body": {
      "type": "object",
      "required": [
        "schema",
        "kind",
        "repository",
        "tag",
        "source_revision",
        "authorization_sha256",
        "handoff_sha256",
        "dispatch_request_sha256",
        "claim_check_run_id",
        "coordinator_run_id",
        "coordinator_run_attempt",
        "publisher_workflow",
        "publisher_ref",
        "publisher_revision",
        "publisher_workflow_sha",
        "publisher_run_id",
        "publisher_run_attempt",
        "issued_at",
        "issuer"
      ],
      "properties": {
        "schema": {
          "const": "codicarium.publisher-dispatch-receipt/v1"
        },
        "kind": {
          "const": "publisher-dispatch-receipt"
        },
        "repository": {
          "const": "codicarium/deployment-controller"
        },
        "tag": {
          "const": "v0.6.14"
        },
        "source_revision": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        },
        "authorization_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "handoff_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "dispatch_request_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "claim_check_run_id": {
          "type": "string",
          "pattern": "^[1-9][0-9]*$"
        },
        "coordinator_run_id": {
          "type": "string",
          "pattern": "^[1-9][0-9]*$"
        },
        "coordinator_run_attempt": {
          "type": "string",
          "pattern": "^[1-9][0-9]*$"
        },
        "publisher_workflow": {
          "const": "codicarium/deployment-controller/.github/workflows/publish-release-v2.yaml"
        },
        "publisher_ref": {
          "const": "refs/heads/main"
        },
        "publisher_revision": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        },
        "publisher_workflow_sha": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        },
        "publisher_run_id": {
          "type": "string",
          "pattern": "^[1-9][0-9]*$"
        },
        "publisher_run_attempt": {
          "type": "string",
          "pattern": "^[1-9][0-9]*$"
        },
        "issued_at": {
          "type": "string",
          "pattern": "^[0-9]{4}-(0[1-9]|1[0-2])-([0-2][0-9]|3[01])T([01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9]Z$"
        },
        "issuer": {
          "type": "object",
          "required": [
            "kind",
            "repository_id",
            "workflow",
            "ref",
            "workflow_sha",
            "run_id",
            "run_attempt"
          ],
          "properties": {
            "kind": {
              "const": "github-actions"
            },
            "repository_id": {
              "const": "1303901324"
            },
            "workflow": {
              "type": "string",
              "minLength": 1
            },
            "ref": {
              "const": "refs/heads/main"
            },
            "workflow_sha": {
              "type": "string",
              "pattern": "^[0-9a-f]{40}$"
            },
            "run_id": {
              "type": "string",
              "pattern": "^[1-9][0-9]*$"
            },
            "run_attempt": {
              "type": "string",
              "pattern": "^[1-9][0-9]*$"
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "signature": {
      "type": "object",
      "required": [
        "format",
        "kid",
        "payload_sha256",
        "signature_base64url"
      ],
      "properties": {
        "format": {
          "const": "ed25519-jcs/v1"
        },
        "kid": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]+$"
        },
        "payload_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "signature_base64url": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]+$"
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
