        "kid": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]+$"
        },
        "payload_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "signature_base64url": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]+$"
        }
