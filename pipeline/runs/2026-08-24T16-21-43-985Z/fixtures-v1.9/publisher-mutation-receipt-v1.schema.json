                },
                "target_commitish": {
                  "type": "string",
                  "pattern": "^[0-9a-f]{40}$"
                },
                "draft": {
                  "const": false
                },
                "prerelease": {
                  "const": false
                }
              },
              "additionalProperties": false
            }
          ]
        }
