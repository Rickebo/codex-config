                  "size": {
                    "type": "string",
                    "pattern": "^[1-9][0-9]*$"
                  },
                  "sha256": {
                    "type": "string",
                    "pattern": "^[0-9a-f]{64}$"
                  }
                },
                "additionalProperties": false
