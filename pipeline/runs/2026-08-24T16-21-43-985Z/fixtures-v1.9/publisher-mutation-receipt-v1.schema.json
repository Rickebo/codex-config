      "properties": {
        "schema": {
          "const": "codicarium.publisher-mutation-receipt/v1"
        },
        "kind": {
          "const": "publisher-mutation-receipt"
        },
        "dispatch_receipt_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "sequence": {
          "type": "string",
          "pattern": "^[1-9][0-9]*$"
        },
        "previous_receipt_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
