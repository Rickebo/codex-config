{
  "live_default": "REJECT",
  "sigstore": {
    "required": [
      "Fulcio chain to pinned root",
      "certificate SAN exact workflow identity",
      "OIDC issuer",
      "repository",
      "workflow ref and SHA",
      "Rekor inclusion proof and signed tree head",
      "integrated time inside evidence window"
    ]
  },
  "vault": {
    "required": [
      "Ed25519 public key pinned by transit key version",
      "offline signature verification",
      "exact Kubernetes principal",
      "key not revoked"
    ]
  },
  "fixture": {
    "algorithm": "Ed25519",
    "authority": false
  },
  "time": {
    "current_time_required": true,
    "max_clock_skew_seconds": 30
  },
  "replay": {
    "store": "durable SQLite unique(issuer,nonce,claim,epoch,sequence)",
    "cross_process_test": true
  }
}
