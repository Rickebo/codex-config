{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://codicarium.local/v2.4/command.v2.4",
  "title": "command.v2.4",
  "type": "object",
  "required": [
    "command_id",
    "argv",
    "digest"
  ],
  "properties": {
    "command_id": {
      "type": "string",
      "minLength": 1
    },
    "argv": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "digest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    }
  },
  "additionalProperties": false
}
