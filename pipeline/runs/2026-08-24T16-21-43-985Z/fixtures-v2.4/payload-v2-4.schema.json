{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://codicarium.local/v2.4/payload.v2.4",
  "title": "payload.v2.4",
  "type": "object",
  "required": [
    "command_id",
    "signer_kind",
    "authority",
    "nonce",
    "issued_at",
    "schema_id",
    "target_digest",
    "argv"
  ],
  "properties": {
    "command_id": {
      "type": "string",
      "minLength": 1
    },
    "signer_kind": {
      "type": "string",
      "minLength": 1
    },
    "authority": {
      "type": "boolean"
    },
    "nonce": {
      "type": "string",
      "minLength": 1
    },
    "issued_at": {
      "type": "string",
      "minLength": 1
    },
    "schema_id": {
      "type": "string",
      "minLength": 1
    },
    "target_digest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "argv": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "signature": {
      "type": "string",
      "minLength": 1
    },
    "record_hash": {
      "type": "string",
      "minLength": 1
    },
    "sequence": {
      "type": "integer"
    },
    "previous_hash": {
      "type": "string",
      "minLength": 1
    },
    "identity": {
      "type": "string",
      "minLength": 1
    },
    "approval_ttl_seconds": {
      "type": "integer"
    },
    "credential_use": {
      "type": "boolean"
    },
    "fsm_transition": {
      "type": "string",
      "minLength": 1
    },
    "app_config_scope": {
      "type": "string",
      "minLength": 1
    },
    "release_version": {
      "type": "string",
      "minLength": 1
    },
    "asset_media_type": {
      "type": "string",
      "minLength": 1
    },
    "asset_source_sha256": {
      "type": "string",
      "minLength": 1
    },
    "destination_binding": {
      "type": "string",
      "minLength": 1
    },
    "revoked": {
      "type": "boolean"
    },
    "live_evidence": {
      "type": "boolean"
    },
    "allowed_transitions": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    }
  },
  "additionalProperties": false
}
