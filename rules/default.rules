prefix_rule(pattern=["/usr/bin/bash", "-lc", "PLAYWRIGHT_BROWSERS_PATH=.toolcache/ms-playwright node -e \"const { chromium } = require('./tests/Codexus.Web.Playwright/bin/Release/net10.0/.playwright/package'); (async()=>{ const browser = await chromium.launch({ headless: true }); const page = await browser.newPage({ viewport: { width: 1440, height: 960 } }); await page.goto('http://127.0.0.1:5182'); await page.waitForSelector('[data-testid=app-shell]'); await page.getByTestId('topbar-settings').click({ force: true }); await page.waitForSelector('[data-testid=settings-dialog-wrapper][data-dialog-state=open]'); const before = await page.evaluate(() => { const backdrop = document.querySelector('[data-testid=\\'settings-dialog-backdrop\\']'); const wrapper = document.querySelector('[data-testid=\\'settings-dialog-wrapper\\']'); const panel = document.querySelector('[role=\\'dialog\\']'); const at = document.elementFromPoint(10, 10); return { backdrop: backdrop ? { tag: backdrop.tagName, className: backdrop.className, pointerEvents: getComputedStyle(backdrop).pointerEvents, rect: backdrop.getBoundingClientRect().toJSON?.() ?? null } : null, wrapper: wrapper ? { className: wrapper.className, rect: wrapper.getBoundingClientRect().toJSON?.() ?? null, dialogState: wrapper.getAttribute('data-dialog-state') } : null, panel: panel ? { className: panel.className, rect: panel.getBoundingClientRect().toJSON?.() ?? null } : null, elementAtViewport1010: at ? { tag: at.tagName, className: at.className, testid: at.getAttribute('data-testid') } : null }; }); console.log('BEFORE', JSON.stringify(before)); await page.getByTestId('settings-dialog-backdrop').click({ force: true, position: { x: 5, y: 5 } }); await page.waitForTimeout(500); const after = await page.evaluate(() => { const wrapper = document.querySelector('[data-testid=\\'settings-dialog-wrapper\\']'); return { wrapperPresent: !!wrapper, dialogState: wrapper?.getAttribute('data-dialog-state') ?? null, openWrappers: document.querySelectorAll('[data-testid=\\'settings-dialog-wrapper\\'][data-dialog-state=\\'open\\']').length }; }); console.log('AFTER', JSON.stringify(after)); await browser.close(); })().catch(err=>{ console.error(err); process.exit(1); });\""], decision="allow")
prefix_rule(pattern=["systemctl", "--user", "show"], decision="allow")
prefix_rule(pattern=["/usr/bin/bash", "-lc", "CODEXUS_BASE_URL=http://127.0.0.1:5184 dotnet test tests/Codexus.Web.Playwright/Codexus.Web.Playwright.csproj -c Release --no-build --filter \"FullyQualifiedName~ShellSmokeOverlayAndSecondaryFlowTests.SettingsAndNotificationsDismissOnBackdropWhileGeneralAndLogsRemainReachableAsync\" --logger \"console;verbosity=minimal\""], decision="allow")
prefix_rule(pattern=["/usr/bin/bash", "-lc", "TOKEN=$(kubectl --kubeconfig ~/.kube/homelab.yaml -n cert-manager get secret cloudflare-api-token -o jsonpath='{.data.api-token}' | base64 -d); curl -sS -H \"Authorization: Bearer $TOKEN\" -H \"Content-Type: application/json\" \"https://api.cloudflare.com/client/v4/zones?name=rickebo.com\""], decision="allow")
prefix_rule(pattern=["/usr/bin/bash", "-lc", "FILTER_BRANCH_SQUELCH_WARNING=1 git filter-branch -f --msg-filter 'sed \"1s/^Fix Gemini TOML escaped quote scanning$/fix(gemini): scan escaped quotes in TOML parser/\"' origin/main..HEAD"], decision="allow")
prefix_rule(pattern=["/usr/bin/bash", "-lc", "gh issue create --title \"Migrate release workflows off GitHub artifact/cache actions to codicarium-actions\" --label codex-tracked --label priority:p2 --body $'## Problem\\nRelease workflows still depend on GitHub artifact/cache actions instead of the repo-local storage actions.\\n\\n## Scope\\n- Replace `actions/upload-artifact`, `actions/download-artifact`, and `actions/cache` references in Codexus workflows with `codicarium/codicarium-actions`.\\n- Handle any required runtime prerequisites for the replacement actions.\\n\\n## Acceptance Criteria\\n- All workflow references in this repo to `actions/upload-artifact`, `actions/download-artifact`, and `actions/cache` are replaced with `codicarium/codicarium-actions`.\\n- The updated workflows handle any required runtime/tooling prerequisites.\\n- The migration lands through a green PR and no GitHub-artifact/cache usage remains in repo workflows.'"], decision="allow")
